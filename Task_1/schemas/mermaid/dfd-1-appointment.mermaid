graph TD
    classDef external fill:#f9f9f9,stroke:#333,stroke-width:2px,stroke-dasharray:5 5;
    classDef process fill:#e1f5fe,stroke:#01579b,stroke-width:2px;
    classDef storage fill:#fff3e0,stroke:#e65100,stroke-width:2px;

    Patient["Пациент"]:::external
    Doctor["Врач"]:::external
    ReceptionStaff["Сотрудник ресепшена"]:::external

    P1(("1.1 Проверка/регистрация пациента (Excel -> Postgres)")):::process
    P2(("1.2 Тегирование данных (автоматическое)")):::process
    P3(("1.3 Создание записи к врачу (Excel -> Postgres)")):::process
    P4(("1.4 Формирование напоминания (автоматическое)")):::process
    P5(("1.5 Чтение расписания (Excel -> портал врача)")):::process

    DB[("Postgres (пациенты, записи, теги)")]:::storage
    AuditStore[("Хранилище аудита")]:::storage

    Patient -->|"Контактные данные и жалоба [Класс_2]"| P1
    ReceptionStaff -->|"Ввод данных (только для пришедших лично) [Класс_3]"| P1
    
    P1 -->|"Данные пациента [Класс_3]"| P2
    P1 -->|"Лог регистрации [Класс_5]"| AuditStore
    
    P2 -->|"Данные с тегами [Класс_3]"| DB
    P2 -->|"Лог тегирования [Класс_5]"| AuditStore
    
    DB -->|"Данные пациента [Класс_3]"| P3
    P3 -->|"Запись к врачу [Класс_2]"| DB
    P3 -->|"Лог записи [Класс_5]"| AuditStore
    
    DB -->|"Записи на завтра [Класс_2]"| P4
    P4 -->|"Напоминание [Класс_3]"| Patient
    P4 -->|"Лог отправки [Класс_5]"| AuditStore
    
    DB -->|"Расписание врача [Класс_2]"| P5
    P5 -->|"Просмотр расписания [Класс_2]"| Doctor