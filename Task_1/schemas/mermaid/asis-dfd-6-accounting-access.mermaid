graph TD
    classDef external fill:#f9f9f9,stroke:#333,stroke-width:2px,stroke-dasharray:5 5;
    classDef process fill:#e1f5fe,stroke:#01579b,stroke-width:2px;
    classDef storage fill:#fff3e0,stroke:#e65100,stroke-width:2px;

    Employee["Сотрудник"]:::external
    HR["Кадровик"]:::external
    Accountant["Бухгалтер"]:::external

    P1(("6.1 Оформление сотрудника")):::process
    P2(("6.2 Начисление зарплаты")):::process
    P3(("6.3 Формирование отчётности в ФНС")):::process

    S1[("1С:Бухгалтерия (кадры)")]:::storage
    S2[("1С:Бухгалтерия (зарплата)")]:::storage

    Employee -->|"Паспорт, ИНН, СНИЛС [Класс_3]"| P1
    HR -->|"Ввод данных [Класс_3]"| P1
    P1 -->|"Данные сотрудника [Класс_3]"| S1

    S1 -->|"Данные о сотрудниках [Класс_3]"| P2
    P2 -->|"Начисление зарплаты [Класс_4]"| S2

    Accountant -->|"Запрос на отчётность [Класс_5]"| P3
    P3 -->|"Данные для ФНС [Класс_3-4]"| S2