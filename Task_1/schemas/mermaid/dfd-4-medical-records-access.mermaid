graph TD
    classDef external fill:#f9f9f9,stroke:#333,stroke-width:2px,stroke-dasharray:5 5;
    classDef process fill:#e1f5fe,stroke:#01579b,stroke-width:2px;
    classDef storage fill:#fff3e0,stroke:#e65100,stroke-width:2px;

    Doctor["Врач"]:::external
    ReceptionStaff["Сотрудник ресепшена"]:::external
    AnyStaff["Любой сотрудник"]:::external

    P1(("4.1 Создание медкарты (файл на сервере -> заполнение формы на портале)")):::process
    P2(("4.2 Тегирование данных (автоматическое + ручное)")):::process
    P3(("4.3 Обновление медкарты (нет аудита -> аудит)")):::process
    P4(("4.4 Чтение медкарты (нет контроля -> ABAC)")):::process

    Portal[("Postgres (новое хранилище)")]:::storage
    AuditStore[("Хранилище аудита доступа")]:::storage

    ReceptionStaff -->|"Скан договора и анкета [Класс_2]"| P1
    Doctor -->|"Диагноз, заключение, анамнез [Класс_1]"| P3
    
    P1 -->|"Данные медкарты [Класс_2]"| P2
    P3 -->|"Обновлённые данные [Класс_1]"| P2
    
    P2 -->|"Данные с тегами [Класс_1-4]"| Portal
    
    AnyStaff -->|"Запрос на доступ"| P4
    P4 -->|"Разрешить чтение [Класс_1-2]"| Portal
    P4 -->|"Запись аудита [Класс_5]"| AuditStore